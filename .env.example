# --- Database (server only) -------------------------------------------------
# Supabase: Project settings > Database > Connection string (Session pooler). Never expose this to the browser.
DATABASE_URL=postgres://postgres@localhost:5432/sauri
# Used only by `npm test`; the suite wipes and re-migrates this database. The name must end in _test.
TEST_DATABASE_URL=postgres://postgres@localhost:5432/sauri_test
# Business time zone for "today", "this year" and every report.
STORE_TIMEZONE=Asia/Phnom_Penh

# --- Supabase Auth (public by design: the anon key is protected by RLS) -----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The service_role key is NOT needed and must never be added to NEXT_PUBLIC_* or client code.

# --- Local development without Supabase (ignored in production) ------------
# Acts as this staff member, who must exist in the users table (e.g. owner@sauri.example after db:seed).
AUTH_DEV_STAFF_EMAIL=

# --- Stripe (Phase 4: checkout, payment & order processing) -----------------
# Test-mode keys. Provisioned automatically if you install the Stripe integration via
# `vercel integration add stripe` (Vercel Marketplace) and run `vercel env pull`; see docs/PAYMENTS.md.
# Never put a live (sk_live_/rk_live_) key here or in any committed file.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Only Stripe knows this — copy it from `stripe listen` (local dev) or the Stripe Dashboard webhook
# endpoint you create after deploying (production). See docs/WEBHOOKS.md.
STRIPE_WEBHOOK_SECRET=

# --- Scheduled jobs -----------------------------------------------------------
# Authorizes calls to /api/cron/release-reservations (Vercel Cron sends this as a Bearer token
# automatically once set; see vercel.json). Any long random string.
CRON_SECRET=
